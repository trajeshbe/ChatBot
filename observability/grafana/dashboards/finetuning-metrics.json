          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  name,\n  status,\n  base_model,\n  COALESCE(train_loss, 0)::numeric(10,4) as train_loss,\n  COALESCE(eval_loss, 0)::numeric(10,4) as eval_loss,\n  current_epoch,\n  progress,\n  created_at\nFROM finetuning_jobs\nWHERE created_at > NOW() - INTERVAL '24 hours'\nORDER BY created_at DESC\nLIMIT 20;",
