# ========================================
# LLM API Keys
# ========================================

# OpenAI Configuration (Optional - for fallback and tool selection)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Configuration (Required for Claude CLI Agent)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# HuggingFace Configuration (Optional - for vLLM models)
HUGGING_FACE_HUB_TOKEN=your-hf-token-here

# vLLM Model Configuration
VLLM_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ragchatbot

# Redis Configuration
REDIS_PASSWORD=

# MinIO Configuration
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Application Configuration
DEBUG=true
ENABLE_TRACING=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8000/graphql

# ========================================
# HYBRID AGENT SYSTEM (Claude Code Integration)
# ========================================

# Agent Mode Configuration
AGENT_MODE_ENABLED=true
AGENT_MODE_DEFAULT=false

# API Budget Limits (Cost Control for Claude CLI)
DAILY_API_BUDGET_LIMIT=10.0
MONTHLY_API_BUDGET_LIMIT=200.0

# Agent Iteration Limits
LOCAL_MINI_AGENT_MAX_ITERATIONS=20
CLAUDE_CLI_AGENT_MAX_ITERATIONS=50
AGENT_EXECUTION_TIMEOUT_SECONDS=600

# Ollama Model Configuration (Local Agent)
AGENT_CODE_MODEL=qwen2.5-coder:7b
AGENT_VISION_MODEL=llama3.2-vision:11b
AGENT_BACKUP_MODEL=deepseek-coder:6.7b
OLLAMA_BASE_URL=http://rag-ollama:11434

# Agent Runtime Configuration
AGENT_WORKSPACE_BASE=/tmp/agent_workspaces
AGENT_CONTAINER_IMAGE=chatbot-agent-runtime:v1.0.0
AGENT_ENABLE_STREAMING=true

# Fine-Tuning Configuration
# Fine-tuning Docker image version (update after rebuilding trainer image)
# v1.0.5: Added text column handling for story datasets (2025-12-24)
FINETUNING_TRAINER_IMAGE=chatbot-finetuning-trainer:v1.0.5
FINETUNING_AUTO_MERGE=true  # Auto-merge LoRA adapters after training (recommended)

# Task Complexity Thresholds
COMPLEXITY_SIMPLE_THRESHOLD=0.3
COMPLEXITY_MEDIUM_THRESHOLD=0.6

# Hybrid Routing Preferences
PREFER_LOCAL_FOR_DATA_ANALYSIS=true
PREFER_LOCAL_FOR_CODE_GENERATION=true
PREFER_LOCAL_FOR_VISION=true
PREFER_CLAUDE_FOR_RESEARCH=true
PREFER_CLAUDE_FOR_WEB_AUTOMATION=true
